{
  "Manim Dock: Section marker": {
    "prefix": "md-section",
    "body": [
      "self.next_section(\"${1:Name}\")",
      "$0"
    ],
    "description": "P12 — ManimCE section marker for chapterized video"
  },
  "Manim Dock: Title card": {
    "prefix": "md-title",
    "body": [
      "title = Text(\"${1:Hook question?}\", font_size=40)",
      "title.to_edge(UP)",
      "self.play(Write(title), run_time=1.2)",
      "self.wait(${2:0.5})",
      "$0"
    ],
    "description": "P01 — title / hook card"
  },
  "Manim Dock: Step list": {
    "prefix": "md-steps",
    "body": [
      "steps = VGroup(",
      "    Text(\"1. ${1:First}\"),",
      "    Text(\"2. ${2:Second}\"),",
      "    Text(\"3. ${3:Third}\"),",
      ").arrange(DOWN, aligned_edge=LEFT, buff=0.3)",
      "self.play(LaggedStart(*[FadeIn(s, shift=RIGHT * 0.2) for s in steps], lag_ratio=0.35))",
      "self.wait(${4:0.5})",
      "$0"
    ],
    "description": "P03 — lagged step list reveal"
  },
  "Manim Dock: Equation emphasize": {
    "prefix": "md-eq",
    "body": [
      "eq = MathTex(\"${1:{{a}}^2}\", \"${2:+}\", \"${3:{{b}}^2}\", \"${4:=}\", \"${5:{{c}}^2}\")",
      "self.play(Write(eq))",
      "self.play(Indicate(eq[${6:0}]))",
      "self.wait(${7:0.5})",
      "$0"
    ],
    "description": "P04 — MathTex write + Indicate"
  },
  "Manim Dock: TransformMatchingTex": {
    "prefix": "md-tmt",
    "body": [
      "eq2 = MathTex(${1:\"{{a}}^2\", \"=\", \"{{c}}^2\", \"-\", \"{{b}}^2\"})",
      "self.play(TransformMatchingTex(${2:eq}, eq2), run_time=${3:1.5})",
      "self.wait(${4:0.5})",
      "$0"
    ],
    "description": "P05 — derivation step via TransformMatchingTex"
  },
  "Manim Dock: Definition card": {
    "prefix": "md-def",
    "body": [
      "heading = Text(\"Definition\", color=${1:BLUE}, font_size=36)",
      "body = Text(\"${2:…}\", font_size=28)",
      "card = VGroup(heading, body).arrange(DOWN, aligned_edge=LEFT, buff=0.25)",
      "card.to_edge(UP)",
      "box = SurroundingRectangle(card, color=${1:BLUE}, buff=0.2)",
      "group = VGroup(card, box)",
      "self.play(FadeIn(group, shift=DOWN * 0.2))",
      "self.wait(${3:0.5})",
      "$0"
    ],
    "description": "P02 — definition card (plain Manim)"
  },
  "Manim Dock: lesson_lib title_card": {
    "prefix": "md-lib-title",
    "body": [
      "from lesson_lib import title_card",
      "title_card(self, \"${1:Hook question?}\")",
      "$0"
    ],
    "description": "P15 — call plain lesson_lib helper (PYTHONPATH=examples)"
  },
  "Manim Dock: Two-column layout": {
    "prefix": "md-cols",
    "body": [
      "left = VGroup(",
      "    ${1:Circle(radius=0.8)},",
      "    Text(\"${2:label}\", font_size=24),",
      ").arrange(DOWN, buff=0.2)",
      "right = VGroup(",
      "    Text(\"${3:Explanation}\", font_size=28),",
      "    ${4:MathTex(\"a^2 + b^2 = c^2\")},",
      ").arrange(DOWN, buff=0.3, aligned_edge=LEFT)",
      "columns = VGroup(left, right).arrange(RIGHT, buff=${5:1.2})",
      "columns.move_to(ORIGIN)",
      "self.play(FadeIn(columns))",
      "self.wait(${6:0.5})",
      "$0"
    ],
    "description": "P06 — two-column diagram | explanation"
  },
  "Manim Dock: Cleanup fade": {
    "prefix": "md-cleanup",
    "body": [
      "leftovers = Group(*self.mobjects)",
      "if len(leftovers):",
      "    self.play(FadeOut(leftovers))",
      "self.wait(${1:0.2})",
      "$0"
    ],
    "description": "P11 — fade out survivors / progressive cleanup"
  },
  "Manim Dock: Color and timing constants": {
    "prefix": "md-consts",
    "body": [
      "PRIMARY = ${1:BLUE}",
      "DEFAULT_WAIT = ${2:0.5}",
      "$0"
    ],
    "description": "Shared color/timing tokens (PRIMARY, DEFAULT_WAIT)"
  }
}
