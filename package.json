{
  "name": "manim-dock",
  "displayName": "Manim Dock",
  "description": "Dock Outline, Stage, and Timeline beside ManimCE Python for educational video production.",
  "version": "0.0.2",
  "publisher": "manim-dock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koseishinoda/manim-dock.git"
  },
  "bugs": {
    "url": "https://github.com/koseishinoda/manim-dock/issues"
  },
  "homepage": "https://github.com/koseishinoda/manim-dock#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "manim",
    "manimce",
    "animation",
    "education"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "workspaceContains:**/*.py"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "manim-dock",
          "title": "Manim Dock",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "manim-dock": [
        {
          "id": "manimDock.outline",
          "name": "Outline"
        }
      ]
    },
    "commands": [
      {
        "command": "manimDock.refreshOutline",
        "title": "Manim Dock: Refresh Outline",
        "icon": "$(refresh)"
      },
      {
        "command": "manimDock.doctor",
        "title": "Manim Dock: Doctor"
      },
      {
        "command": "manimDock.revealInEditor",
        "title": "Manim Dock: Reveal in Editor"
      },
      {
        "command": "manimDock.renderScene",
        "title": "Manim Dock: Render Scene (QL)",
        "icon": "$(play)"
      },
      {
        "command": "manimDock.renderWithSections",
        "title": "Manim Dock: Render with Sections",
        "icon": "$(versions)"
      },
      {
        "command": "manimDock.renderSkipToSection",
        "title": "Manim Dock: Render Skip to Section",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "manimDock.openStage",
        "title": "Manim Dock: Open Stage",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "manimDock.openTimeline",
        "title": "Manim Dock: Open Timeline",
        "icon": "$(graph-line)"
      },
      {
        "command": "manimDock.openProperties",
        "title": "Manim Dock: Open Properties",
        "icon": "$(settings-gear)"
      },
      {
        "command": "manimDock.insertTemplate",
        "title": "Manim Dock: Insert Template",
        "icon": "$(file-code)"
      },
      {
        "command": "manimDock.scaffoldExample",
        "title": "Manim Dock: Scaffold Example Project"
      },
      {
        "command": "manimDock.setPatchMode",
        "title": "Manim Dock: Set Patch Mode"
      },
      {
        "command": "manimDock.extractMethod",
        "title": "Manim Dock: Extract Method to Library",
        "icon": "$(export)"
      },
      {
        "command": "manimDock.browseLibrary",
        "title": "Manim Dock: Browse Library Helpers",
        "icon": "$(book)"
      },
      {
        "command": "manimDock.renderMethod",
        "title": "Manim Dock: Render Method",
        "icon": "$(play-circle)"
      },
      {
        "command": "manimDock.debugSidecar",
        "title": "Manim Dock: Debug Sidecar"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "manimDock.refreshOutline",
          "when": "view == manimDock.outline",
          "group": "navigation"
        },
        {
          "command": "manimDock.openStage",
          "when": "view == manimDock.outline",
          "group": "navigation"
        },
        {
          "command": "manimDock.openTimeline",
          "when": "view == manimDock.outline",
          "group": "navigation"
        },
        {
          "command": "manimDock.openProperties",
          "when": "view == manimDock.outline",
          "group": "navigation"
        },
        {
          "command": "manimDock.renderScene",
          "when": "view == manimDock.outline",
          "group": "navigation"
        },
        {
          "command": "manimDock.renderWithSections",
          "when": "view == manimDock.outline",
          "group": "1_render"
        },
        {
          "command": "manimDock.renderSkipToSection",
          "when": "view == manimDock.outline",
          "group": "1_render"
        },
        {
          "command": "manimDock.insertTemplate",
          "when": "view == manimDock.outline",
          "group": "2_templates"
        },
        {
          "command": "manimDock.setPatchMode",
          "when": "view == manimDock.outline",
          "group": "3_settings"
        }
      ],
      "commandPalette": [
        {
          "command": "manimDock.setPatchMode"
        },
        {
          "command": "manimDock.scaffoldExample"
        },
        {
          "command": "manimDock.browseLibrary"
        },
        {
          "command": "manimDock.renderMethod"
        }
      ],
      "view/item/context": [
        {
          "command": "manimDock.openStage",
          "when": "view == manimDock.outline && viewItem == manimDock.scene",
          "group": "inline@1"
        },
        {
          "command": "manimDock.openTimeline",
          "when": "view == manimDock.outline && viewItem == manimDock.scene",
          "group": "inline@2"
        },
        {
          "command": "manimDock.openProperties",
          "when": "view == manimDock.outline && viewItem == manimDock.scene",
          "group": "inline@3"
        },
        {
          "command": "manimDock.renderScene",
          "when": "view == manimDock.outline && viewItem == manimDock.scene",
          "group": "inline@4"
        },
        {
          "command": "manimDock.renderWithSections",
          "when": "view == manimDock.outline && viewItem == manimDock.scene",
          "group": "1_render"
        },
        {
          "command": "manimDock.renderSkipToSection",
          "when": "view == manimDock.outline && viewItem == manimDock.scene",
          "group": "1_render"
        },
        {
          "command": "manimDock.extractMethod",
          "when": "view == manimDock.outline && viewItem == manimDock.method",
          "group": "inline@1"
        },
        {
          "command": "manimDock.renderMethod",
          "when": "view == manimDock.outline && viewItem == manimDock.method",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "manimDock.browseLibrary"
        },
        {
          "command": "manimDock.renderMethod"
        }
      ],
      "editor/title": [
        {
          "command": "manimDock.openStage",
          "when": "resourceLangId == python",
          "group": "navigation"
        },
        {
          "command": "manimDock.openTimeline",
          "when": "resourceLangId == python",
          "group": "navigation"
        },
        {
          "command": "manimDock.openProperties",
          "when": "resourceLangId == python",
          "group": "navigation"
        },
        {
          "command": "manimDock.renderScene",
          "when": "resourceLangId == python",
          "group": "navigation"
        },
        {
          "command": "manimDock.insertTemplate",
          "when": "resourceLangId == python",
          "group": "1_manimDock"
        },
        {
          "command": "manimDock.renderWithSections",
          "when": "resourceLangId == python",
          "group": "1_manimDock"
        },
        {
          "command": "manimDock.browseLibrary",
          "when": "resourceLangId == python",
          "group": "1_manimDock"
        },
        {
          "command": "manimDock.renderMethod",
          "when": "resourceLangId == python",
          "group": "1_manimDock"
        }
      ]
    },
    "configuration": {
      "title": "Manim Dock",
      "properties": {
        "manimDock.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter for the Manim Dock sidecar. Empty = use the VS Code Python extension interpreter, else `python3`."
        },
        "manimDock.sidecarModule": {
          "type": "string",
          "default": "manim_dock",
          "description": "Python module name for the sidecar (development default: manim_dock)."
        },
        "manimDock.renderQuality": {
          "type": "string",
          "default": "l",
          "enum": [
            "l",
            "m",
            "h",
            "k"
          ],
          "enumDescriptions": [
            "480p15 (fast preview)",
            "720p30",
            "1080p60",
            "2160p60"
          ],
          "description": "Manim quality flag for Manim Dock: Render Scene."
        },
        "manimDock.patchMode": {
          "type": "string",
          "default": "confirm",
          "enum": [
            "confirm",
            "auto"
          ],
          "enumDescriptions": [
            "Show confirm-diff, then Apply / Cancel",
            "Apply immediately via WorkspaceEdit (Undo with Ctrl/Cmd+Z)"
          ],
          "markdownDescription": "How Stage / Timeline / Properties patches are applied to Python source. Also available via command **Manim Dock: Set Patch Mode**."
        }
      }
    },
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/manim-dock.code-snippets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "package": "npm run compile && npx --no-install vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "konva": "^9.3.22"
  }
}
